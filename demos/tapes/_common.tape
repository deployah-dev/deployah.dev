# Shared VHS settings. Size is in _hero.tape or _well.tape.
# Source this from a demo tape, then the size tape, then _zsh.tape.
# Wait /λ/ matches the Starship prompt.

Set Shell "zsh"
Set Theme "Dracula"
Set WindowBar Colorful
Set TypingSpeed 55ms
Set CursorBlink false
Set Margin 12
Set Padding 12
Set BorderRadius 15
# Kind create + first deploy can take several minutes (default WaitTimeout is 15s).
Set WaitTimeout 15m
